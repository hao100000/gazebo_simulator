<?xml version="1.0" ?>
<robot name="omuni_nakamura_v11" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<transmission name="rotate_joint_1_tran">
  <type>transmission_interface/SimpleTransmission</type>
  <joint name="rotate_joint_1">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
  </joint>
  <actuator name="rotate_joint_1_actr">
    <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    <mechanicalReduction>1</mechanicalReduction>
  </actuator>
</transmission>

